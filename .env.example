# Ultravox API Configuration
VITE_ULTRAVOX_API_KEY=your-ultravox-api-key-here

# Gemini API Configuration (for AI-powered form field enhancement)
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ElevenLabs API Configuration (for multilingual voice TTS)
# Get your API key from: https://elevenlabs.io
# Required for multilingual voice support; falls back to Ultravox built-in voice without it
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here